# ============================================================
# 吟游 Loom · .gitignore
# ============================================================

# ---------- 高云 Gowin EDA 综合产物 ----------
# 全部限定在 fpga/ 下，避免误伤其它目录的同名文件
fpga/build/
fpga/**/impl/
fpga/**/*.fs
fpga/**/*.bin
fpga/**/*.rbf
fpga/**/*.prj
fpga/**/*.ipc
fpga/**/*.log
fpga/**/*.html
fpga/**/*.xml
fpga/**/*.srr
fpga/**/*.tr
fpga/**/*.pat
*.gprj.user
*.cst.bak
*.sdc.bak

# ---------- 仿真产物 ----------
# 只排除"跑出来的"东西，不排除源文件
*.vvp
*.vcd
*.lxt
*.lxt2
*.fst
sim/out/
sim/*.wav
sim/*.pcm
sim/*.raw

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 操作系统 ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- 临时文件 ----------
*.tmp
~$*

# ---------- 本地实验 / 参考资料（保留在磁盘，不进入主仓库） ----------
# refs/ 内含官方示例的嵌套 git 仓库与约 100MB 的位流文件，直接提交会把主库搞乱
refs/
tmp/

# ---------- PlatformIO 构建产物（experiments/ 下的 STM32 调试工程） ----------
.pio/

# ---------- PCB 历史备份与日志 ----------
PCB/*_backup/
PCB/PCB_backup/
PCB/debug.log
PCB/carrier_v0/.history/

# ============================================================
# 说明：以下内容**必须提交**，不要加入忽略列表
#   data/wavetables/*.hex   RTL 的 $readmemh 依赖它
#   tools/*.py              工程工具，保证可复现
#   sim/tb_*.v              仿真套件
# ============================================================

// p6_test_demo pin constraints
// Device: GW2AR-LV18QN88C8/I7

// 板载 27 MHz 晶振
IO_LOC "clk" 4;
IO_PORT "clk" PULL_MODE=UP IO_TYPE=LVCMOS33;

// 演奏键：C4/D4/E4/F4/G4/A4/B4，低有效
IO_LOC "key_n[0]" 28;
IO_PORT "key_n[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "key_n[1]" 29;
IO_PORT "key_n[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "key_n[2]" 30;
IO_PORT "key_n[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "key_n[3]" 31;
IO_PORT "key_n[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;
// K5-K7（2026-10-17 新增）：G4/A4/B4
IO_LOC "key_n[4]" 77;
IO_PORT "key_n[4]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "key_n[5]" 85;
IO_PORT "key_n[5]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "key_n[6]" 86;
IO_PORT "key_n[6]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// 摇杆 RC 采集（2026-10-17）：PIN48 / PIN49
// 外部已有 47k 上拉到 3V3，这里必须关闭内部上下拉
IO_LOC "joy_x" 48;
IO_PORT "joy_x" PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_LOC "joy_y" 49;
IO_PORT "joy_y" PULL_MODE=NONE IO_TYPE=LVCMOS33;

// 板载 S1 / S2：音色与效果器切换，低有效
IO_LOC "key_timbre_n" 88;
IO_PORT "key_timbre_n" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "key_fx_n" 87;
IO_PORT "key_fx_n" PULL_MODE=UP IO_TYPE=LVCMOS33;

// 模式开关（独奏 / 和弦）：低 = 独奏 MONO，高 = 和弦 CHORD
IO_LOC "key_mode_n" 27;
IO_PORT "key_mode_n" PULL_MODE=UP IO_TYPE=LVCMOS33;

// 电平开关（HI / LO）：低 = LO（约 −6dB），高 = HI
IO_LOC "key_level_n" 25;
IO_PORT "key_level_n" PULL_MODE=UP IO_TYPE=LVCMOS33;

// 音频功放使能与 I2S
IO_LOC "pa_en" 51;
IO_PORT "pa_en" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "i2s_din" 54;
IO_PORT "i2s_din" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "i2s_lrck" 55;
IO_PORT "i2s_lrck" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "i2s_bclk" 56;
IO_PORT "i2s_bclk" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// 2.4 寸 ST7789 TFT（横屏 UI，见 docs/22）：PIN71-76
// ⚠️ BLK 必须 PULL_MODE=DOWN：配置期间 IO 高阻，否则背光会半亮/闪
IO_LOC "tft_sclk" 71;
IO_PORT "tft_sclk" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "tft_mosi" 72;
IO_PORT "tft_mosi" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "tft_cs_n" 73;
IO_PORT "tft_cs_n" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "tft_dc" 74;
IO_PORT "tft_dc" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "tft_res_n" 75;
IO_PORT "tft_res_n" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "tft_blk" 76;
IO_PORT "tft_blk" PULL_MODE=DOWN DRIVE=8 IO_TYPE=LVCMOS33;

// 板载 LED，低电平点亮
IO_LOC "led_n[0]" 15;
IO_PORT "led_n[0]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[1]" 16;
IO_PORT "led_n[1]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[2]" 17;
IO_PORT "led_n[2]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[3]" 18;
IO_PORT "led_n[3]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[4]" 19;
IO_PORT "led_n[4]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[5]" 20;
IO_PORT "led_n[5]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// tft_pin_probe pin constraints（与 tft_bringup 完全相同的引脚）
// Device: GW2AR-LV18QN88C8/I7

IO_LOC "clk" 4;
IO_PORT "clk" PULL_MODE=UP IO_TYPE=LVCMOS33;

// 模块排针 3/4/7/6/5 → SCLK/MOSI/CS/DC/RES
IO_LOC "sclk" 71;
IO_PORT "sclk" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "mosi" 72;
IO_PORT "mosi" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "cs_n" 73;
IO_PORT "cs_n" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "dc" 74;
IO_PORT "dc" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "res_n" 75;
IO_PORT "res_n" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "blk" 76;
IO_PORT "blk" PULL_MODE=DOWN DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC "led_n[0]" 15;
IO_PORT "led_n[0]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[1]" 16;
IO_PORT "led_n[1]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[2]" 17;
IO_PORT "led_n[2]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[3]" 18;
IO_PORT "led_n[3]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[4]" 19;
IO_PORT "led_n[4]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// ============================================================
// oled_demo.cst —— SH1106 I2C 屏幕实验的引脚约束
// 器件：GW2AR-LV18QN88C8/I7
// ============================================================

// 板载 27MHz 晶振
IO_LOC "clk" 4;
IO_PORT "clk" PULL_MODE=UP IO_TYPE=LVCMOS33;

// 板载按键 S1（按下为低）
IO_LOC "key_n" 88;
IO_PORT "key_n" PULL_MODE=UP IO_TYPE=LVCMOS33;

// 板载按键 S2（按下为低）：用于切换 OLED 初始化序列
IO_LOC "key2_n" 87;
IO_PORT "key2_n" PULL_MODE=UP IO_TYPE=LVCMOS33;

// I2C：SCL -> PIN52，SDA -> PIN53
// 使能内部上拉：若 OLED 模块自带 4.7k 上拉也无妨，并联只会让上升沿更快
IO_LOC "scl" 52;
IO_PORT "scl" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

IO_LOC "sda" 53;
IO_PORT "sda" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// 板载 LED（低电平点亮），仅用于调试指示
IO_LOC "led_n[0]" 15;
IO_PORT "led_n[0]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[1]" 16;
IO_PORT "led_n[1]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC "led_n[2]" 17;
IO_PORT "led_n[2]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
